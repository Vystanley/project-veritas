{
  "design_system": {
    "identity": {
      "name": "Veritas - AI Fact Checker",
      "tone": "Authoritative, Transparent, High-Tech, Unbiased",
      "visual_archetype": "The Digital Observatory",
      "keywords": ["Truth", "Scan", "Verify", "Data Stream", "Clarity"]
    },
    "typography": {
      "font_family": {
        "headings": "JetBrains Mono",
        "body": "Manrope",
        "data": "Roboto Mono"
      },
      "scale": {
        "xs": "12px",
        "sm": "14px",
        "base": "16px",
        "lg": "18px",
        "xl": "20px",
        "2xl": "24px",
        "3xl": "30px",
        "4xl": "36px"
      },
      "weights": {
        "light": "300",
        "regular": "400",
        "medium": "500",
        "bold": "700"
      }
    },
    "colors": {
      "palette": {
        "background": {
          "main": "#020617",
          "surface": "#0f172a",
          "overlay": "rgba(2, 6, 23, 0.85)"
        },
        "text": {
          "primary": "#f8fafc",
          "secondary": "#94a3b8",
          "tertiary": "#475569",
          "accent": "#38bdf8"
        },
        "border": {
          "default": "#1e293b",
          "active": "#38bdf8"
        },
        "status": {
          "true": "#10b981",
          "partially_true": "#f59e0b",
          "false": "#ef4444",
          "info": "#3b82f6"
        },
        "brand": {
          "primary": "#3b82f6",
          "secondary": "#6366f1",
          "glow": "rgba(59, 130, 246, 0.5)"
        }
      },
      "gradients": {
        "main_bg": "linear-gradient(180deg, #020617 0%, #0f172a 100%)",
        "card_glow": "linear-gradient(135deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0) 100%)"
      }
    },
    "spacing": {
      "xs": 4,
      "sm": 8,
      "md": 16,
      "lg": 24,
      "xl": 32,
      "2xl": 48,
      "3xl": 64
    },
    "borders": {
      "radius": {
        "sm": 6,
        "md": 12,
        "lg": 18,
        "full": 9999
      },
      "width": {
        "thin": 1,
        "thick": 2
      }
    },
    "shadows": {
      "soft": "0 4px 6px -1px rgba(0, 0, 0, 0.3)",
      "glow": "0 0 15px rgba(59, 130, 246, 0.3)",
      "neon": "0 0 10px rgba(56, 189, 248, 0.5), 0 0 20px rgba(56, 189, 248, 0.3)"
    }
  },
  "components": {
    "buttons": {
      "primary": {
        "bg": "bg-blue-600",
        "text": "text-white",
        "rounded": "rounded-full",
        "padding": "py-4 px-8",
        "shadow": "shadow-lg shadow-blue-500/30",
        "animation": "active:scale-95 transition-transform"
      },
      "secondary": {
        "bg": "bg-slate-800",
        "text": "text-slate-200",
        "rounded": "rounded-full",
        "padding": "py-3 px-6",
        "border": "border border-slate-700"
      },
      "ghost": {
        "bg": "bg-transparent",
        "text": "text-slate-400",
        "hover": "bg-slate-800/50"
      }
    },
    "inputs": {
      "main_search": {
        "bg": "bg-slate-900/80",
        "border": "border border-slate-700",
        "focus": "border-blue-500 ring-2 ring-blue-500/20",
        "text": "text-white placeholder:text-slate-500",
        "rounded": "rounded-2xl",
        "height": "h-14"
      }
    },
    "cards": {
      "result": {
        "bg": "bg-slate-900",
        "border": "border border-slate-800",
        "rounded": "rounded-3xl",
        "padding": "p-6",
        "effect": "glassmorphism"
      },
      "claim_item": {
        "bg": "bg-slate-950/50",
        "border": "border-l-4",
        "rounded": "rounded-r-xl rounded-l-none",
        "padding": "p-4"
      }
    }
  },
  "layout_strategies": {
    "auth_screen": {
      "structure": "Split View (Top Image / Bottom Form)",
      "background": "Dark gradient with subtle data stream overlay",
      "elements": [
        "Logo (Top Center)",
        "Title (Bold, Large)",
        "Subtitle (Slate-400)",
        "Inputs (Email, Password)",
        "Primary Button (Login/Register)",
        "Toggle (Switch Mode)"
      ]
    },
    "home_screen": {
      "structure": "Centered Focus",
      "background": "Deep Navy (#020617)",
      "elements": [
        "Header (Profile Icon, App Name)",
        "Hero Text ('Paste Video URL')",
        "Main Input Field (Floating, Large)",
        "Paste Button (Icon)",
        "Analyze Button (Primary, glowing)",
        "Recent Scans (Horizontal Scroll List)"
      ]
    },
    "results_screen": {
      "structure": "Bento Grid (Vertical Scroll)",
      "elements": [
        "Verdict Card (Top, Sticky, Dynamic Color based on Truth)",
        "Video Thumbnail (Small, Top Right of Verdict)",
        "Score Gauge (Circular Progress)",
        "Claims List (Vertical Stack)",
        "Sources Section (Links with Icons)",
        "Share Button (Floating Bottom Right)"
      ]
    }
  },
  "assets": {
    "images": {
      "auth_background": "https://images.unsplash.com/photo-1761645502922-fe3dde9f7341?crop=entropy&cs=srgb&fm=jpg&ixid=M3w4NjA4Mzl8MHwxfHNlYXJjaHwzfHxhYnN0cmFjdCUyMGRpZ2l0YWwlMjBkYXRhJTIwc3RyZWFtJTIwZGFyayUyMGJsdWV8ZW58MHx8fHwxNzcxNjk3MzUwfDA&ixlib=rb-4.1.0&q=85",
      "home_abstract": "https://images.unsplash.com/photo-1762279388956-1c098163a2a8?crop=entropy&cs=srgb&fm=jpg&ixid=M3w4NjA4Mzl8MHwxfHNlYXJjaHw0fHxhYnN0cmFjdCUyMGRpZ2l0YWwlMjBkYXRhJTIwc3RyZWFtJTIwZGFyayUyMGJsdWV8ZW58MHx8fHwxNzcxNjk3MzUwfDA&ixlib=rb-4.1.0&q=85",
      "empty_state": "https://images.unsplash.com/photo-1764258560730-d167e5deda65?crop=entropy&cs=srgb&fm=jpg&ixid=M3w4NjA4Mzl8MHwxfHNlYXJjaHwxfHxhYnN0cmFjdCUyMGRpZ2l0YWwlMjBkYXRhJTIwc3RyZWFtJTIwZGFyayUyMGJsdWV8ZW58MHx8fHwxNzcxNjk3MzUwfDA&ixlib=rb-4.1.0&q=85"
    },
    "icons": {
      "library": "Lucide React Native",
      "preferred": ["ShieldCheck", "ScanLine", "AlertTriangle", "CheckCircle", "XCircle", "Link", "Share2", "User", "LogOut"]
    }
  },
  "animation_guidelines": {
    "transitions": {
      "screen": "Slide from right (standard iOS)",
      "modal": "Slide up from bottom"
    },
    "micro_interactions": {
      "button_press": "Scale down to 0.95",
      "input_focus": "Border glow turns blue",
      "loading": "A horizontal line scanning up and down over the content"
    },
    "libraries": {
      "motion": "react-native-reanimated",
      "gestures": "react-native-gesture-handler"
    }
  },
  "implementation_rules": {
    "framework": "React Native (Expo)",
    "styling": "NativeWind (Tailwind classes)",
    "navigation": "Expo Router or React Navigation",
    "safe_area": "Ensure all screens are wrapped in SafeAreaView",
    "touch_targets": "Minimum 44x44px for all interactive elements",
    "keyboard_handling": "Wrap forms in KeyboardAvoidingView with behavior='padding'",
    "status_bar": "Light content (white text) on dark background"
  },
  "universal_guidelines": [
    "Do NOT use HTML elements like div, span, h1. Use View, Text, SafeAreaView, TouchableOpacity.",
    "Do NOT use gradients on text unless absolutely necessary for a logo.",
    "Use 'flex-1' to fill available space in containers.",
    "Always handle loading states with a visible activity indicator or skeleton loader.",
    "Ensure high contrast between text and background (Accessibility AA standard).",
    "Use data-testid on all interactive elements for testing."
  ]
}